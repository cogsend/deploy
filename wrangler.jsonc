{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cogsend",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_als"
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"redact_query_string": true
	},
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cogsend",
			"database_id": "",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cogsend-media"
		}
	],
	"main": "worker/_worker.js",
	"no_bundle": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "assets"
	},
	"vars": {
		"COGSEND_INSTALL": "button"
	}
}
